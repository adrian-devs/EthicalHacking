# /etc/systemd/system/music-manager.service
[Unit]
Description=Music Manager (gunicorn)
After=network.target

[Service]
User=musicmgr
Group=musicmgr
WorkingDirectory=/opt/music-manager
EnvironmentFile=/etc/music-manager.env
ExecStart=/opt/music-manager/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 --access-logfile - app:app
Restart=on-failure

# Endurecimiento del proceso
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/music-manager/instance
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
