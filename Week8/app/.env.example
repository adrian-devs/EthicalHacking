# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# development (por defecto) o production
APP_ENV=development

# OBLIGATORIA en producción. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Hosts permitidos (cabecera Host), separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1

# 1 = permite crear cuentas desde /register; 0 = deshabilita el registro
ALLOW_REGISTRATION=1

# Opcional: base de datos distinta de SQLite
# DATABASE_URL=sqlite:///music.db

# Opcional: nº de proxies inversos de confianza (nginx, Caddy). 0 = ninguno
TRUSTED_PROXY_COUNT=0

# Opcional: almacenamiento del límite de peticiones (en producción usa Redis)
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# Solo para depurar en tu equipo (ignorado en producción)
# FLASK_DEBUG=1

# Código de invitación para /register. Con valor, nadie sin el código puede crear cuentas
# ni averiguar qué usuarios existen (recomendado si dejas el registro abierto).
REGISTRATION_CODE=

# Minutos de inactividad antes de cerrar la sesión (por defecto 30)
IDLE_TIMEOUT_MINUTES=30
