# /etc/music-manager.env   (chmod 600, dueño root). NUNCA lo subas al repositorio.
APP_ENV=production
SECRET_KEY=          # python -c "import secrets; print(secrets.token_hex(32))"
ALLOWED_HOSTS=example.com
TRUSTED_PROXY_COUNT=1
ALLOW_REGISTRATION=1
REGISTRATION_CODE=   # código de invitación (obligatorio en la práctica si dejas el registro abierto)
IDLE_TIMEOUT_MINUTES=30
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379
